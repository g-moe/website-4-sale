{
  "name": "website-4-sale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "dev": "npm run check:env && vite",
    "build": "npm run check:env && tsgo --noEmit && vite build",
    "preview": "npm run check:env && vite preview",
    "fmt": "npm run check:env && oxfmt",
    "fmt:check": "npm run check:env && oxfmt --check",
    "lint": "npm run check:env && oxlint",
    "check": "npm run check:env && oxfmt --check && oxlint && tsgo --noEmit && vite build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
